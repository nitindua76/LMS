POSTGRES_USER=lms
POSTGRES_PASSWORD=lmspassword
POSTGRES_DB=lms

REDIS_URL=redis://redis:6379/0

JWT_SECRET=dev-only-secret-replace-in-production-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Only the main LMS frontend goes here — the content origin must NOT be in this list
# because it would allow session-cookie-bearing requests from package JS.
#
# TEMPORARY, ACCEPTED TRADEOFF: content and web now share the same hostname
# (appserver1.ongc.co.in — no second DNS name available for this host), so
# the SameSite isolation described in README.md between the LMS app and the
# SCORM/cmi5 content origin no longer holds — they're same-site. Fine for
# this single-tester HTTPS check; do NOT carry this into a real deployment
# with real user sessions — get a second hostname (e.g. content.ongc.co.in)
# and restore two-origin separation first, same as docker-compose.prod.yml.
#
# Comma-separated — add every origin a browser will actually send as its
# Origin header. Exact scheme+host+port match, no wildcards.
CORS_ORIGINS=http://localhost:5173

# Comma-separated extra hostnames the Vite dev server itself will accept
# (separate from CORS_ORIGINS above — this gates the Host header before the
# request even reaches CORS/the API). Only needed for hostnames; plain IPs
# are always allowed by Vite. Leave blank for single-machine dev.
VITE_ALLOWED_HOSTS=localhost

ENVIRONMENT=development
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_SECONDS=300
ACCOUNT_MAX_ATTEMPTS=10
ACCOUNT_LOCKOUT_SECONDS=900

# Used by the Vite dev server proxy (Node.js side, not the browser).
VITE_API_URL=http://localhost:8000

# MinIO / Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=lmsadmin
MINIO_SECRET_KEY=lmspassword
MINIO_BUCKET=lms-packages
MINIO_SECURE=false
# Note: docker-compose.yml's `environment:` block for the api service
# overrides this value. Now https:// and same hostname as the main app (see
# the CORS_ORIGINS comment above for why) — the nginx TLS service terminates
# this on port 5175. This line is kept for scripts/tooling that read .env
# directly outside compose.
CONTENT_ORIGIN=http://localhost:5175

# The URL the browser uses to reach the API directly (not via Vite proxy).
# Used in SCORM/cmi5 launch URLs embedded in loader.html at the content origin.
API_EXTERNAL_URL=http://localhost:8000

# LRS (xAPI) - mock LRS runs at localhost:9090 via docker-compose
# Set to empty string to disable forwarding in dev without Docker
LRS_ENDPOINT=http://localhost:9090
LRS_USERNAME=
LRS_PASSWORD=

# SCORM session token secret
SCORM_TOKEN_SECRET=dev-scorm-secret-replace-in-production

# Hostname/IP the BROWSER uses to reach LiveKit directly (signaling +
# published UDP/TCP media ports) — never localhost, since remote machines
# resolve that to themselves. Must match livekit/livekit.yaml's node_ip
# (that one has to be a raw IP; this can be a hostname that resolves to the
# same host, e.g. an internal DNS name). Signaling now goes over wss://
# through the nginx TLS service on port 7880 (see docker-compose.yml's api
# service, which builds LIVEKIT_URL from this as wss://${LIVEKIT_HOST}:7880).
LIVEKIT_HOST=localhost

# Corporate proxy — build-time only (see api/Dockerfile, web/Dockerfile).
# Used solely while building the api/web images (apt-get, pip, npm); never
# injected into the running containers, since they talk to db/redis/minio/
# livekit/etc. by compose service name, which this proxy can't resolve.
# Leave blank on networks that don't require a proxy.
#HTTP_PROXY=http://10.205.48.15:8080
#HTTPS_PROXY=http://10.205.48.15:8080
#NO_PROXY=localhost,127.0.0.1

# DNS servers the api container uses at runtime to resolve internal-only
# ONGC hostnames (e.g. the SSO/Employee API host) — Docker's default
# embedded resolver forwards to public DNS, which can't see these. Taken
# from this host's own configured DNS servers (`ipconfig` on Windows).
#DNS_SERVER_1=10.205.55.247
#DNS_SERVER_2=10.205.55.252
