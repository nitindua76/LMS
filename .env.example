# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=lms
POSTGRES_PASSWORD=lmspassword
POSTGRES_DB=lms

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=change-me-in-production-generate-with-secrets-token-hex-64
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookies ───────────────────────────────────────────────────────────────────
# Set COOKIE_SECURE=true and COOKIE_SAMESITE=strict in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated, exact scheme+host+port match (no wildcards). Add every
# origin a browser will send — e.g. to test from another machine on the LAN,
# add its address here: http://localhost:5173,http://192.168.1.50:5173
CORS_ORIGINS=http://localhost:5173

# Comma-separated extra hostnames the Vite dev server accepts requests for
# (gates the Host header before CORS is even checked). Only needed for
# hostnames — plain IP addresses are always allowed. Leave blank normally.
# VITE_ALLOWED_HOSTS=lms.internal,teammate-pc.local

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Rate limiting: max failed login attempts before lockout
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_SECONDS=300
ACCOUNT_MAX_ATTEMPTS=10
ACCOUNT_LOCKOUT_SECONDS=900

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── LiveKit (live sessions / video conferencing) ─────────────────────────────
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-in-production-generate-with-secrets-token-hex-32
# Hostname/IP the BROWSER uses to reach LiveKit directly — leave as
# localhost for single-machine dev. Testing from another machine on the LAN
# needs this set to a hostname/IP that resolves to this host (e.g. its LAN
# IP or an internal DNS name), and livekit/livekit.yaml's node_ip must match
# it exactly (that file takes a raw IP, not a hostname).
LIVEKIT_HOST=localhost

# ── Corporate proxy (build-time only, optional) ──────────────────────────────
# Only needed on networks that require an outbound proxy for Docker image
# builds (apt-get/pip/npm). Leave blank/unset if not behind a proxy. Never
# used at container runtime — see api/Dockerfile and web/Dockerfile.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# ── Internal DNS (runtime, api container only) ────────────────────────────────
# Only needed if SSO_API_BASE_URL/EMPLOYEE_API_BASE_URL point at an
# internal-only hostname that public DNS (Docker's default resolver
# forwards to 8.8.8.8/8.8.4.4) can't resolve — common on a corporate
# network. Set to whatever DNS server(s) this host itself uses (Windows:
# `ipconfig`; look for the DNS Servers line on the active adapter). Leave
# unset/default if SSO endpoints use a publicly-resolvable hostname or IP.
# DNS_SERVER_1=10.0.0.1
# DNS_SERVER_2=10.0.0.2

# ── SSO (CPF login) ───────────────────────────────────────────────────────────
# Credential-check API. This must be the FULL endpoint URL including path
# (e.g. https://appserver1.ongc.co.in:8089/Employee/chkCredential) — not
# just a host. Called as POST with cpf/pwd/server sent BOTH as query-string
# params AND as a JSON body ({"cpf": "...", "pwd": "..."}); expects
# {"Message":"VALID"} or {"Message":"INVALID"} back. Leave blank to disable
# CPF login entirely; local email/password accounts (see admin/users.py)
# keep working either way, so this is safe to leave unset in dev. All of
# these can also be overridden at runtime from the admin Settings page
# (system_settings table takes priority over these env vars — see
# services/settings_service.py).
SSO_API_BASE_URL=
SSO_API_TIMEOUT_SECONDS=8.0
# The `server` query param the endpoint expects — every environment seen so
# far uses AD, exposed here in case that ever differs.
SSO_SERVER=AD
# Set to false to make CPF login the ONLY way in — do this only once SSO is
# confirmed reachable, since it removes the local-password break-glass path.
ENABLE_LOCAL_LOGIN_FALLBACK=true

# ── Employee API (profile + reporting-hierarchy sync) ────────────────────────
# GET ?cpf=...&apiKey=... — returns profile fields plus CONTROLLING/L1/L2/
# IC_HRER hierarchy. Used to auto-provision/refresh User rows after a
# successful SSO login and by CPF-add flows (courses, groups, Instant Room
# membership). Never blocks login if unreachable — a failure here just means
# the profile fills in on the next successful sync instead of immediately.
EMPLOYEE_API_BASE_URL=
# Treat this the same as a password — never commit a real value here.
EMPLOYEE_API_KEY=
EMPLOYEE_API_TIMEOUT_SECONDS=8.0
EMPLOYEE_SYNC_ON_LOGIN=true

# ── Instant Rooms (day-to-day meeting rooms) ──────────────────────────────────
# Global kill switch — set to false to immediately stop new rooms being
# created org-wide (does not end rooms already in progress; use the admin
# Live Sessions dashboard's "End All" for that). Per-user room-creation
# privilege is a separate toggle on each employee's detail page in the
# admin Employees section.
INSTANT_ROOMS_ENABLED=true
# The browser-facing base URL for this app — used to build the shareable
# "join this room" link (copy-link button + auto-mail-on-invite below).
# Never localhost — has to be a hostname/IP a recipient's own browser can
# reach, same reasoning as LIVEKIT_HOST.
FRONTEND_URL=https://appserver1.ongc.co.in:5173

# ── Meeting-link auto-mail ────────────────────────────────────────────────────
# Sends a join-link email to a room member automatically when they're
# added (to the ADDED MEMBER's own email, never the room owner's). Uses the
# corporate mail API with {mailid}, {link}, and {name} as literal
# placeholders substituted at send time ({name} is the room's display
# name, e.g. "Daily standup"). Blank disables auto-mail; the "Copy link"
# button in the UI keeps working regardless. Overridable at runtime via the
# admin Settings page (system_settings takes priority over this env var).
MAIL_API_URL_TEMPLATE=https://appserver1.ongc.co.in:8089/MailApi/mail?mailid={mailid}&msg=LMS%20Automated%20Mail%20Service&subject={name}%20DISCUSSION%20LINK&template=LMS_LINK&templateparams=templateBody::{link},,templateHeader::{name}%20DISCUSSION%20LINK
MAIL_API_TIMEOUT_SECONDS=8.0
