# Production environment — copy to .env.prod on the VM and fill in real
# values. NEVER commit .env.prod (it's in .gitignore already).

# ── Networking (internal-only deployment, no public DNS) ────────────────────
# The hostname employees will browse to — must resolve to the VM's IP via
# internal DNS or a hosts-file entry on each machine. Also used by Caddy to
# issue its internal TLS cert (see Caddyfile) and by LiveKit's node_ip.
INTERNAL_HOSTNAME=lms.internal
# The VM's actual LAN IP (not 127.0.0.1) — other employees' machines need to
# reach LiveKit's media ports here directly for video/audio to connect.
LIVEKIT_NODE_IP=10.0.0.50
# Defaults (56000-56100) deliberately do NOT match LiveKit's usual
# 55000-55100 — docker-compose.yml (dev) already publishes that exact range
# directly on this same host. If you ONLY ever run prod on this machine
# (never dev concurrently), you can safely use 55000-55100 here instead.
# See DEPLOYMENT.md's "Running dev and prod concurrently" section.
LIVEKIT_RTC_PORT_RANGE_START=56000
LIVEKIT_RTC_PORT_RANGE_END=56100

# ── Prod-side externally-published ports ─────────────────────────────────────
# These four all default (in docker-compose.prod.yml/Caddyfile) to the
# values below even if you never set them here — only override if you need
# something different (e.g. a port already used by something else on this
# machine, or if you're deploying prod to its OWN dedicated VM with no dev
# stack running alongside it, in which case reverting to the "obvious"
# ports — 443, 7880, 7881, 5174 — is fine and arguably more conventional).
#
# On the current dev+prod machine, none of the "obvious" ports work: 443 is
# inside Windows' own reserved TCP port exclusion range (`netsh interface
# ipv4 show excludedportrange protocol=tcp` — confirmed on this host) and
# Docker Desktop cannot bind it at all; 7880/7881/5174 are already
# published directly by docker-compose.yml (dev) on this same host.
PROD_HTTPS_PORT=8543
PROD_LIVEKIT_WSS_PORT=8780
PROD_LIVEKIT_RTC_TCP_PORT=8781
PROD_CONTENT_PORT=8174
PROD_MINIO_PUBLIC_PORT=9002
# Optional — only needed for direct DB client access (DBeaver, psql, etc.)
# for admin/debugging. Postgres is NOT published to the host otherwise.
# Default (5438) differs from dev's published Postgres port (5437).
PROD_POSTGRES_PORT=5438

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me-generate-a-real-password
POSTGRES_DB=lms

# ── Redis / MinIO ─────────────────────────────────────────────────────────────
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-generate-a-real-password

# ── JWT / cookies ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=change-me-generate-with-secrets-token-hex-64
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── SCORM session tokens ──────────────────────────────────────────────────────
SCORM_TOKEN_SECRET=change-me-generate-with-secrets-token-hex-32

# ── LiveKit ───────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=change-me
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
LIVEKIT_API_SECRET=change-me-generate-with-secrets-token-hex-32

# ── SMTP (real internal mail relay — there's no Mailpit in production) ──────
SMTP_HOST=mail.yourcompany.internal
SMTP_PORT=25
SMTP_FROM=lms@yourcompany.com

# ── Container registry / image tag (used by docker-compose.prod.yml) ────────
REGISTRY=ghcr.io
GITHUB_REPOSITORY=your-org/lms
IMAGE_TAG=latest

# ── Outbound proxy (only needed if this network requires one to reach the
# public internet — e.g. PyPI, for the lrs service's pip install at
# container start). Leave blank if this VM has direct internet access.
# Same values as the dev .env's HTTP_PROXY/HTTPS_PROXY, if set there.
# NOTE: the api service explicitly clears these at runtime regardless of
# what's set here (see docker-compose.prod.yml) — if INTERNAL_HOSTNAME is
# this same host's own internal hostname (reachable directly, not through
# the proxy), routing SSO/Employee API calls through this proxy would fail.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# ── DNS servers for the api container, only needed if SSO_API_BASE_URL /
# EMPLOYEE_API_BASE_URL point at an internal-only hostname that doesn't
# resolve via Docker's default embedded DNS (which forwards to public
# resolvers). Leave blank if not applicable. Same values as the dev .env's
# DNS_SERVER_1/2, if set there.
DNS_SERVER_1=
DNS_SERVER_2=
