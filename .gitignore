# Secrets — never commit real environment files
.env
.env.prod
.env.local

# TLS certificate/private key — never commit
ssl/

# nginx config — machine-specific (office uses TLS certs, dev uses no nginx)
nginx/

# Docker compose override — machine-specific dev settings
docker-compose.override.yml

# Generated from templates at deploy time (contains real LiveKit keys)
livekit/livekit.prod.yaml

# Python
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
dist/

# Database dumps
*.sql

# Editors/OS
.vscode/
.idea/
.DS_Store
Thumbs.db
package-lock.json
