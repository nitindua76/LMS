# Secrets — never commit real environment files
.env
.env.prod
.env.local

# TLS certificate/private key — never commit
ssl/

# Docker compose override — machine-specific dev settings
# (nginx is bypassed here via the 'tls' profile; the office machine still
#  uses nginx/nginx.conf, which IS tracked in git and shared between machines)
docker-compose.override.yml

# Generated from templates at deploy time (contains real LiveKit keys)
livekit/livekit.prod.yaml

# Python
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
dist/

# Database dumps
*.sql

# Editors/OS
.vscode/
.idea/
.DS_Store
Thumbs.db
package-lock.json
