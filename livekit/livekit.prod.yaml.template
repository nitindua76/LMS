# Template — scripts/deploy.ps1 substitutes __NODE_IP__, __LIVEKIT_KEY__,
# __LIVEKIT_SECRET__, and __RTC_TCP_PORT__ from .env.prod and writes the
# result to livekit.prod.yaml (git-ignored; never commit the real keys).
#
# `port: 7880` below is this CONTAINER's internal signaling port — never
# published directly to the host in prod (Caddy reaches it over the
# compose network as livekit:7880, see docker-compose.prod.yml), so it
# does not need to change for dev/prod coexistence and is left as-is.
port: 7880
rtc:
  # Directly published to the host (see docker-compose.prod.yml's livekit
  # service) — MUST match ${PROD_LIVEKIT_RTC_TCP_PORT} there exactly, since
  # this is also the port LiveKit advertises to clients as a TCP ICE
  # candidate. Templated (not hardcoded 7881) because docker-compose.yml
  # (dev) already publishes 7881 directly on this same host when both run
  # concurrently — see DEPLOYMENT.md's "Running dev and prod concurrently".
  tcp_port: __RTC_TCP_PORT__
  port_range_start: __RTC_PORT_RANGE_START__
  port_range_end: __RTC_PORT_RANGE_END__
  use_external_ip: false
  # Must be the VM's actual internal LAN IP (not 127.0.0.1 — real employee
  # machines elsewhere on the corporate network need to reach this for
  # media/ICE, not just a browser on the same box). See the same class of
  # bug this fixed in dev: docker's own bridge-network IP is NOT reachable
  # from other machines, so this has to be set explicitly.
  node_ip: __NODE_IP__
# Exposes a Prometheus-format metrics endpoint on this port (GET /metrics)
# — this is what api/app/services/resource_monitor.py polls to build the
# admin Resource Monitor page's live bandwidth/CPU/room numbers. Plain
# HTTP, no auth — deliberately NOT published to the host in
# docker-compose.prod.yml, only reachable from the api container over the
# internal compose network. Same block as livekit/livekit.yaml (dev) — this
# was missing from this template entirely, which meant api's background
# resource-monitor job silently retried against a connection-refused
# endpoint every cycle (confirmed via a real deploy's api logs: "Could not
# reach LiveKit metrics endpoint at http://livekit:6789/metrics").
prometheus:
  port: 6789
redis:
  address: redis:6379
keys:
  __LIVEKIT_KEY__: __LIVEKIT_SECRET__
# Without this, LiveKit never calls app/routers/webhooks/livekit.py —
# attendance rows and automatic session status transitions silently never
# happen (a real bug this deployment work caught in the dev config too).
webhook:
  api_key: __LIVEKIT_KEY__
  urls:
    - http://api:8000/webhooks/livekit
# TURN is left disabled for the initial internal-network rollout — everyone
# is on the same corporate network/VPN, so the restrictive-firewall case
# TURN exists for is much less likely than it would be over the public
# internet. If remote/VPN users hit connectivity trouble, enabling this
# needs its own TLS cert for the TURN listener (Caddy's internal CA cert
# isn't directly usable here since TURN terminates its own TLS, not HTTP).
turn:
  enabled: false
  tls_port: 5349
  udp_port: 3478
